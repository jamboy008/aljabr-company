# APP_URL: The URL where the Next.js application is hosted.
APP_URL="MY_APP_URL"

# FASTAPI_BACKEND_URL: Internal server-side FastAPI Business Backend URL (never exposed to browser).
# Leave empty while unconnected (returns 503 BACKEND_NOT_CONNECTED until configured).
FASTAPI_BACKEND_URL=

# FRONTEND_1_LOGIN_URL: URL of Frontend 1's SSO login entry point when backend is connected and session is absent.
FRONTEND_1_LOGIN_URL=/
